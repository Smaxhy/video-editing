{
  "name": "clipforge",
  "version": "1.0.0",
  "description": "Local AI video editor: Whisper transcribes, Claude Code plans the edit, HyperFrames renders the MP4.",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "start:lan": "node src/server.js --lan",
    "dev": "node --watch src/server.js",
    "setup": "bash scripts/setup.sh",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "express": "^4.22.3",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.186",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "tus-js-client": "^4.3.1"
  }
}
